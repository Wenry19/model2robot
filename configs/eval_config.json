{
    "dataset": {
        "module": "datasets.simple_dataset",
        "class": "SimpleDataset",
        "args": {},
        "transform": {
            "module": "datasets.transforms",
            "function": "get_default_transform",
            "args": {
                "input_height": 224,
                "input_width": 224
            }
        },
        "test_path": "data/Door-Classification/OriginalSize/RGB/test",
        "class_names": [
            "Closed",
            "Open",
            "Semi"
        ]
    },

    "model": {
        "module": "models.detectdoor",
        "class": "Detectdoor",
        "type": "tensorrt",
        "path": "output/tensorrt/t03/best_model.engine",
        "input_width": 224,
        "input_height": 224
    },

    "evaluation": {
        "batch_size": 32
    },

    "dataloader": {
        "num_workers": 4,
        "pin_memory": true
    },
    
    "output_path": "output/eval/tensorrt/t03"
}