{
    "dataset": {
        "train_path": "data/Door-Classification/OriginalSize/RGB/train",
        "val_path": "data/Door-Classification/OriginalSize/RGB/val",
        "class_names": [
            "Closed",
            "Open",
            "Semi"
        ]
    },

    "model": {
        "module": "models.detectdoor",
        "class": "Detectdoor",
        "input_width": 224,
        "input_height": 224
    },

    "training": {
        "epochs": 10,
        "batch_size": 32,
        "learning_rate": 0.00005,
        "optimizer": "Adam",
        "loss": "CrossEntropyLoss"
    },

    "dataloader": {
        "shuffle": true,
        "num_workers": 4,
        "pin_memory": true,
        "drop_last": false
    },

    "seed": 42,
    "output_path": "output/train/t03"
}
